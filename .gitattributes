# Скрипты приставки должны остаться с переводами строк Unix: sh и PARSE_INI
# на \r спотыкаются, и приложение молча не запускается.
*.sh text eol=lf
# Код едет на приставку как есть - пусть везде будут одни переводы строк.
*.py text eol=lf
*.ini text eol=lf
# Файл версии читают и sh запускалки, и питон на приставке:  там ни к чему,
# а расширения у него нет, под *.py и *.sh он не попадает.
VERSION text eol=lf

# А эти два - наоборот, для Windows.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Двоичное не трогать.
*.ttf binary
*.png binary
*.pyz binary
*.muxapp binary
