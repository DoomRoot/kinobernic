@echo off
rem Двойной щелчок по этому файлу открывает установщик.
rem
rem Через .bat, а не напрямую по .ps1: скачанные из интернета скрипты Windows
rem по умолчанию запускать не даёт, а здесь разрешение выдаётся только этому
rem запуску и только этому файлу - в системе ничего не меняется.
chcp 65001 > nul
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0install.ps1"
