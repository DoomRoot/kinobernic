__pycache__/
*.pyc

# Данные каталога собираются catalog_sync.py на самой приставке: 55 МБ обложек
# и баннеров, которые перекачиваются за пару минут. В репозитории им нечего делать.
data/
posters/
banners/
home.json
collections.json

# Личное: токен аккаунта и подобранные на месте настройки экрана.
account.json
settings.json

# Снимки экрана и временные архивы отладки.
*.tar
shots/

# Собранные архивы: место готовым сборкам - в релизах, а не в истории.
# Собираются они всё равно на приставке, командой tools/build_release.py.
dist/

# Стенд: библиотеки, шрифты и его каталог собираются на месте (stand/setup.py).
stand/libs/
stand/fonts/
stand/data/
stand/data_*/
stand/run/
tests/data/

# Код приложения и рабочие заметки в публичном репозитории не лежат: здесь
# только то, что нужно человеку для установки, - README, снимки, установщик
# для компьютера и манифест обновлений. Сами файлы никуда не делись, они на
# месте рядом; из репозитория убрано их опубликование.
app/
знания/
